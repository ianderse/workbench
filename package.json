{
  "name": "workbench",
  "version": "1.0.0-beta",
  "author": {
    "name": "Artyom Vancyan",
    "email": "44609997+artyomvancyan@users.noreply.github.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "node .github/scripts/postinstall.cjs",
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "dev:debug": "cross-env DEBUG=true electron-vite dev",
    "dev:mcp": "electron-vite dev -- --remote-debugging-port=9222",
    "build": "electron-vite build",
    "start": "npm run build && electron .",
    "start:mcp": "electron . --remote-debugging-port=9222",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "verify:linux": "node .github/scripts/verify-linux-packages.cjs dist",
    "start:packaged:mac": "open \"dist/mac-arm64/Workbench.app\" || open \"dist/mac/Workbench.app\"",
    "start:packaged:win": "start \"\" \"dist\\win-unpacked\\Workbench.exe\"",
    "start:packaged:linux": "./dist/linux-unpacked/workbench",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/__tests__/integration/ --exclude src/__tests__/e2e/",
    "test:integration": "vitest run src/__tests__/integration/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental",
    "lint": "knip && knip --production",
    "lint:fix": "knip --fix --fix-type exports,types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lydell/node-pty": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "i18next": "^25.8.18",
    "lucide-react": "^0.577.0",
    "minimatch": "^10.2.4",
    "pixi.js": "^8.22.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.7.4",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "xstate": "^5.28.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "4.0.3",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "electron": "40.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.4.0",
    "knip": "^6.41.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "electron-builder-squirrel-windows": "^26.0.12",
    "dmg-builder": "^26.0.12",
    "@electron/rebuild": "$@electron/rebuild"
  },
  "build": {
    "appId": "com.workbench.app",
    "productName": "Workbench",
    "npmRebuild": false,
    "artifactName": "Workbench-${version}-${platform}-${arch}.${ext}",
    "detectUpdateChannel": false,
    "publish": [
      {
        "provider": "github",
        "owner": "proactive-agent",
        "repo": "workbench"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/main/node_modules/@lydell/node-pty-*/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/tray",
        "to": "tray",
        "filter": [
          "*.png"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "resources/icons",
      "target": [
        "deb"
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "Workbench",
          "StartupWMClass": "Workbench"
        }
      }
    }
  }
}
